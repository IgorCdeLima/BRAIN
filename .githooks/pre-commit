#!/bin/sh
# Protege áreas do repositório contra commits de agentes. Regras em .githooks/regras.json.
# Raiz do ambiente: IA_RAIZ ou a pasta deste repositório (cópia principal, também a partir de worktrees).
RAIZ="${IA_RAIZ:-$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")}"
exec py -3 "$RAIZ/ferramentas/git/verificar_commit.py" pre-commit
