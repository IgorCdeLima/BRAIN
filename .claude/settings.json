{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(Remove-Item * -Recurse*)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/agentes/**)",
      "Edit(/BRAIN/60_Agentes/**)",
      "Edit(/BRAIN/70_Workflows/**)",
      "Edit(/BRAIN/.obsidian/**)",
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git rebase *)",
      "PowerShell(Remove-Item *)"
    ]
  }
}
