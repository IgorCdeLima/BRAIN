{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(//d/01_IA/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git worktree list*)",
      "Bash(git rev-parse*)",
      "Bash(git fetch*)",
      "Bash(git add operacao/tarefas/*)",
      "Bash(git add operacao/pesquisas/*)",
      "Bash(git commit *)",
      "Bash(docker ps*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker volume ls*)",
      "Bash(curl *localhost*)",
      "Bash(curl *127.0.0.1*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git branch*)",
      "PowerShell(git worktree list*)",
      "PowerShell(git rev-parse*)",
      "PowerShell(git fetch*)",
      "PowerShell(git add operacao/tarefas/*)",
      "PowerShell(git commit *)",
      "PowerShell(docker ps*)",
      "PowerShell(docker compose ps*)",
      "PowerShell(docker compose logs*)",
      "PowerShell(docker volume ls*)",
      "PowerShell(curl *localhost*)"
    ],
    "ask": [
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(docker volume rm *)",
      "PowerShell(git merge *)",
      "PowerShell(git push *)",
      "PowerShell(docker compose up*)",
      "PowerShell(docker compose down*)",
      "PowerShell(docker volume rm *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Edit(//d/01_IA/agentes/**)",
      "Edit(//d/01_IA/logs/**)",
      "Edit(//d/01_IA/projetos/**)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash*)",
      "Bash(git branch -D*)",
      "Bash(git worktree remove*)",
      "Bash(docker system prune*)",
      "Bash(docker compose down -v*)",
      "PowerShell(git rebase*)",
      "PowerShell(git reset*)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git stash*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git worktree remove*)",
      "PowerShell(docker system prune*)",
      "PowerShell(docker compose down -v*)"
    ]
  }
}
