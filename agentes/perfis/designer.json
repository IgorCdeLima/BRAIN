{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "D:/01_IA/BRAIN/00_Inbox",
      "D:/01_IA/operacao/tarefas",
      "D:/01_IA/operacao/pesquisas",
      "D:/01_IA/operacao/coordenador"
    ],
    "allow": [
      "Read(//d/01_IA/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add docs/design/*)",
      "Bash(git add qualidade/ux/*)",
      "Bash(git commit *)",
      "Bash(docker compose *)",
      "Bash(APP_PORT=* docker compose *)",
      "Bash(docker ps*)",
      "Bash(curl *localhost*)",
      "Bash(curl *127.0.0.1*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git add docs/design/*)",
      "PowerShell(git add qualidade/ux/*)",
      "PowerShell(git commit *)",
      "PowerShell(docker compose *)",
      "PowerShell($env:APP_PORT=*)",
      "PowerShell($env:APP_PORT=*; docker compose *)",
      "PowerShell(docker ps*)",
      "PowerShell(curl *localhost*)",
      "PowerShell(Invoke-WebRequest *localhost*)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Edit(//d/01_IA/agentes/**)",
      "Edit(//d/01_IA/logs/**)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git reset*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker compose down -v*)",
      "Bash(*docker compose * down -v*)",
      "PowerShell(git push*)",
      "PowerShell(git merge*)",
      "PowerShell(git rebase*)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git reset*)",
      "PowerShell(docker system prune*)",
      "PowerShell(docker volume rm*)",
      "PowerShell(docker compose down -v*)",
      "PowerShell(*docker compose * down -v*)"
    ]
  }
}
