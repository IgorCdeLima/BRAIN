{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(//d/01_IA/**)",
      "WebSearch",
      "WebFetch",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add BRAIN/00_Inbox/*)",
      "Bash(git add operacao/pesquisas/*)",
      "Bash(git add operacao/coordenador/*)",
      "Bash(git commit *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git add BRAIN/00_Inbox/*)",
      "PowerShell(git add operacao/pesquisas/*)",
      "PowerShell(git add operacao/coordenador/*)",
      "PowerShell(git commit *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Edit(//d/01_IA/agentes/**)",
      "Edit(//d/01_IA/logs/**)",
      "Edit(//d/01_IA/projetos/**)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(git push*)",
      "Bash(git merge *)",
      "Bash(git rebase*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git reset*)",
      "PowerShell(curl*)",
      "PowerShell(Invoke-WebRequest*)",
      "PowerShell(Invoke-RestMethod*)",
      "PowerShell(git push*)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase*)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git reset*)"
    ]
  }
}
