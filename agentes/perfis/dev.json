{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "D:/01_IA/BRAIN/00_Inbox",
      "D:/01_IA/operacao/tarefas",
      "D:/01_IA/operacao/pesquisas"
    ],
    "allow": [
      "Read(//d/01_IA/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch --show-current)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(py -3 -m pytest*)",
      "Bash(python -m pytest*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(docker compose *)",
      "PowerShell(docker ps*)",
      "PowerShell(docker logs *)",
      "PowerShell(py -3 -m pytest*)",
      "PowerShell(python -m pytest*)",
      "Bash(APP_PORT=* docker compose *)",
      "PowerShell($env:APP_PORT=*)",
      "PowerShell($env:APP_PORT=*; docker compose *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Edit(qualidade/**)",
      "Edit(//d/01_IA/agentes/**)",
      "Edit(//d/01_IA/logs/**)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git checkout main*)",
      "Bash(git switch main*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker compose down -v*)",
      "PowerShell(git push*)",
      "PowerShell(git merge*)",
      "PowerShell(git rebase*)",
      "PowerShell(git checkout main*)",
      "PowerShell(git switch main*)",
      "PowerShell(docker system prune*)",
      "PowerShell(docker volume rm*)",
      "PowerShell(docker compose down -v*)"
    ]
  }
}
