{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(obsidian *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add BRAIN/*)",
      "Bash(git commit *)",
      "PowerShell(obsidian *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git add BRAIN/*)",
      "PowerShell(git commit *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(BRAIN/60_Agentes/**)",
      "Edit(BRAIN/70_Workflows/**)",
      "Edit(BRAIN/.obsidian/**)",
      "Edit(CLAUDE.md)",
      "Edit(agentes/**)",
      "Edit(ferramentas/**)",
      "Edit(.claude/**)",
      "Edit(.githooks/**)",
      "Edit(projetos/**)",
      "Edit(operacao/qualidade/**)",
      "Edit(logs/**)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "PowerShell(git push*)",
      "PowerShell(git merge*)",
      "PowerShell(git rebase*)"
    ]
  }
}
