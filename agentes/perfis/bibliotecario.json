{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(py -3 ferramentas/notas.py*)",
      "Bash(python3 ferramentas/notas.py*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add BRAIN/*)",
      "Bash(git add operacao/pesquisas/*)",
      "Bash(git add operacao/coordenador/*)",
      "Bash(git commit *)",
   "Bash(py -3 ferramentas/uso_brain.py*)",
   "Bash(python3 ferramentas/uso_brain.py*)",
      "PowerShell(py -3 ferramentas/notas.py*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git add BRAIN/*)",
      "PowerShell(git add operacao/coordenador/*)",
      "PowerShell(git commit *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(BRAIN/60_Agentes/**)",
      "Edit(BRAIN/70_Workflows/**)",
      "Edit(BRAIN/.obsidian/**)",
      "Edit(CLAUDE.md)",
      "Edit(agentes/**)",
      "Edit(ferramentas/**)",
      "Edit(.claude/**)",
      "Edit(.githooks/**)",
      "Edit(projetos/**)",
      "Edit(operacao/qualidade/**)",
      "Edit(logs/**)",
      "Bash(git mv*)",
      "Bash(mv *)",
      "PowerShell(git mv*)",
      "PowerShell(Move-Item*)",
      "PowerShell(Rename-Item*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "PowerShell(git push*)",
      "PowerShell(git merge*)",
      "PowerShell(git rebase*)"
    ]
  }
}
