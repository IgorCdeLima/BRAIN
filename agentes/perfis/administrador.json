{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(//d/01_IA/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a*)",
      "Bash(git branch -v*)",
      "Bash(git worktree list*)",
      "Bash(git rev-parse*)",
      "Bash(git fetch*)",
      "Bash(docker ps*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker volume ls*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch -a*)",
      "PowerShell(git branch -v*)",
      "PowerShell(git worktree list*)",
      "PowerShell(git rev-parse*)",
      "PowerShell(git fetch*)",
      "PowerShell(docker ps*)",
      "PowerShell(docker compose ps*)",
      "PowerShell(docker compose logs*)",
      "PowerShell(docker volume ls*)"
    ],
    "ask": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch -d *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git merge *)",
      "PowerShell(git push *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout *)",
      "PowerShell(git branch -d *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(~/.config/01_ia/**)",
      "Edit(//d/01_IA/logs/**)",
      "Bash(*01_ia/admin*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D*)",
      "Bash(git stash drop*)",
      "Bash(docker system prune*)",
      "Bash(docker compose down -v*)",
      "PowerShell(*01_ia\\admin*)",
      "PowerShell(git rebase*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git stash drop*)",
      "PowerShell(docker system prune*)",
      "PowerShell(docker compose down -v*)"
    ]
  }
}
