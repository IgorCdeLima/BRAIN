{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "D:/01_IA/BRAIN/00_Inbox",
      "D:/01_IA/operacao/tarefas"
    ],
    "allow": [
      "Read(//d/01_IA/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git add qualidade/*)",
      "Bash(git commit *)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(curl *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git rev-parse*)",
      "PowerShell(git add qualidade/*)",
      "PowerShell(git commit *)",
      "PowerShell(docker compose *)",
      "PowerShell(docker ps*)",
      "PowerShell(docker logs *)",
      "PowerShell(curl *)",
      "PowerShell(Invoke-WebRequest *)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Edit(//d/01_IA/agentes/**)",
      "Edit(//d/01_IA/logs/**)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git reset*)",
      "Bash(git stash*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker compose down -v*)",
      "PowerShell(git push*)",
      "PowerShell(git merge*)",
      "PowerShell(git rebase*)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git reset*)",
      "PowerShell(git stash*)",
      "PowerShell(docker system prune*)",
      "PowerShell(docker volume rm*)",
      "PowerShell(docker compose down -v*)"
    ]
  }
}
